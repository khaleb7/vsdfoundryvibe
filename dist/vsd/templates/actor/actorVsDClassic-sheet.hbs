{{debug "The Classic Sheet object:" this}}
{{debug "The Classic Sheet data object:" system}}

<form class="sheetform {{cssClass}}" autocomplete="off">
  <div class="charsheet vsdarkmaster-wrapper">
    <div class="header-grid-section sticky">
      <header class="vsd-classic-header">
        <div class="sectionheader collapsible char-name {{#if (eq system.sections.header 'none')}}collapsed {{/if}}" data-section="header">
          <img class="header-logo" src="systems/vsd/icons/darkmaster_logo.png" title="Against the Darkmaster: The Classic Game of Fantasy Adventure" alt="Logo: Against the Darkmaster - The Classic Game of Fantasy Adventure">
          <input class="actorname" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'local.actor.name'}}" />
        </div>
        <div class="content" style="display: {{system.sections.header}}">
          <div class="layout">
            <div class="portrait">
              <img class="portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
            </div>
            {{#with system.sheetData.headerinfo as |item|}}
            <div class="centre">
              <div class="toprow">
                <div class="headinfo single" title="{{localize 'local.header.toprow.kin'}}">
                  {{item.kin}}
                </div>
                <div class="headinfo single" title="{{localize 'local.header.toprow.culture'}}">
                  {{item.culture}}
                </div>
                <div class="headinfo single" title="{{localize 'local.header.toprow.vocation'}}">
                  {{item.vocation}}
                </div>
                <div class="headinfo triple item" data-item-id="{{item.hitpoints._id}}" title="{{localize 'local.header.toprow.hitpoints'}}">
                  <span class="item-edit"> {{item.hitpoints.system.abbr}}:</span>
                  <input class="value iteminput pool" type="text" value="{{item.hitpoints.system.value}}" data-dtype="Number" data-name="system.value" data-abbr="{{item.hitpoints.system.abbr}}" />
                  <span>/ {{item.hitpoints.system.max}}</span>
                </div>
                <div class="headinfo double" title="{{localize 'local.header.toprow.bleeding'}}">
                  <span> {{localize 'local.header.toprow.bleed'}}</span>
                  <span> {{item.woundsbleed}}/
                    {{localize 'local.header.toprow.round'}}</span>
                </div>
              </div>
              <div class="midrow">
                <div class="headinfo declaration item" data-item-id="{{item.wealth._id}}" title="{{localize 'local.header.midrow.wealth'}}">
                  <span class="item-edit"> {{localize 'local.header.midrow.wl'}} {{item.wealth.system.value}} - </span>
                  <span> {{item.wealth.system.label}}</span>
                  <select class="value select iteminput" data-name="system.label">
                    {{selectOptions item.wealth.system.entries selected=item.wealth.system.label valueAttr="label" labelAttr="label" localize=false}}
                  </select>
                </div>
                <div class="headinfo double" title="{{localize 'local.header.midrow.level'}}">
                  <span> {{localize 'local.header.midrow.lvl'}}</span>
                  <span> {{item.level}}</span>
                </div>
                <div class="headinfo double item" data-item-id="{{item.experience._id}}" title="{{item.experience.system.max}}{{localize 'local.header.midrow.experience'}}">
                  <span class="item-edit"> {{localize 'local.header.midrow.xp'}}</span>
                  <span> {{item.experience.system.value}}</span>
                </div>
                <div class="headinfo triple item" data-item-id="{{item.magicpoints._id}}" title="{{localize 'local.header.midrow.magicpoints'}}">
                  <span class="item-edit"> {{item.magicpoints.system.abbr}}:</span>
                  <input class="value iteminput pool" type="text" value="{{item.magicpoints.system.value}}" data-dtype="Number" data-name="system.value" data-abbr="{{item.magicpoints.system.abbr}}" />
                  <span>/ {{item.magicpoints.system.max}}</span>
                </div>
                <div class="headinfo double" title="{{localize 'local.header.midrow.penalty'}}">
                  <span> {{localize 'local.header.midrow.pen'}}</span>
                  <span> {{item.woundspen}}</span>
                </div>
              </div>
              <div class="bottomrow">
                <div class="headinfo declaration item" data-item-id="{{item.encumbrance._id}}" title="{{localize 'local.header.bottomrow.encumbrance'}}">
                  <span class="item-edit"> {{item.encumbrance.system.label}}</span>
                  <select class="value select iteminput" data-name="system.label">
                    {{selectOptions item.encumbrance.system.entries selected=item.encumbrance.system.label valueAttr="label" labelAttr="label" localize=false}}
                  </select>
                </div>
                <div class="headinfo declaration item" data-item-id="{{item.size._id}}" title="{{localize 'local.header.bottomrow.size'}}">
                  <span class="item-edit"> {{item.size.system.label}}</span>
                  <select class="value select iteminput" data-name="system.label">
                    {{selectOptions item.size.system.entries selected=item.size.system.label valueAttr="label" labelAttr="label" localize=false}}
                  </select>
                </div>
                <div class="headinfo move item" data-item-id="{{item.movemode._id}}" title="{{localize 'local.header.bottomrow.movemode'}}">
                  <span class="item-edit">
                    {{item.movemode.system.label}}</span>
                  <select class="value select iteminput" data-name="system.label">
                    {{selectOptions item.movemode.system.entries selected=item.movemode.system.label valueAttr="label" labelAttr="label" localize=false}}
                  </select>
                </div>
                <div class="headinfo move item" data-item-id="{{item.move._id}}" title="{{localize 'local.header.bottomrow.moverate'}}">
                  <span class="item-edit"> {{localize 'local.header.bottomrow.move'}}</span>
                  <span> {{item.move.system.moddedvalue}} m</span>
                  <select class="value select iteminput" data-name="system.label">
                    {{selectOptions item.move.system.entries selected=item.move.system.label valueAttr="label" labelAttr="label" localize=false}}
                  </select>
                </div>
              </div>
            </div>
            <div class="defences">
              {{#if (eq item.defence.shieldposition "side")}}
              <div class="toprow">
                <div class="headinfo single" title="{{localize 'local.header.defences.title.mel'}}">
                  {{localize 'local.header.defences.mel'}}
                  {{item.defence.meleeDB}}
                </div>
                <div class="headinfo" title="{{localize 'local.header.shield.title'}}">
                  <select class="value select" name="system.defence.shieldposition">
                    {{#if (eq item.defence.meshield 0)}}
                    {{selectOptions ../config.selectOptions.withoutshield selected=item.defence.shieldposition valueAttr="value" labelAttr="label" localize=true}}
                    {{else}}
                    {{selectOptions ../config.selectOptions.withshield selected=item.defence.shieldposition valueAttr="value" labelAttr="label" localize=true}}
                    {{/if}}
                  </select>
                </div>
                <div class="headinfo single" title="{{localize 'local.header.defences.title.rhp'}}">
                  {{localize 'local.header.defences.rhp'}}
                  {{item.defence.righthand}}
                </div>
              </div>
              <div class="midrow">
                <div class="headinfo single" title="{{localize 'local.header.defences.title.msl'}}">
                  {{localize 'local.header.defences.msl'}}
                  {{item.defence.missileDB}}
                </div>
                <div class="headinfo double item" data-item-id="{{item.defence.parry._id}}" title="{{localize 'local.header.defences.title.parry'}}">
                  {{localize 'local.header.defences.parry'}}<input class="value iteminput" type="number" value="{{item.defence.parry.system.value}}" data-dtype="Number" data-name="system.attr" />
                </div>
                <div class="headinfo single" title="{{localize 'local.header.defences.title.at'}}">
                  {{localize 'local.header.defences.at'}}
                  {{item.defence.armourType}}
                </div>
              </div>
              <div class="bottomrow">
                <div class="headinfo single" title="{{localize 'local.header.defences.title.surprise'}}">
                  {{localize 'local.header.defences.surprise'}}
                  {{item.defence.surprise}}
                </div>
                <div class="headinfo single" title="{{localize 'local.header.defences.title.basedb'}}">
                  {{localize 'local.header.defences.basedb'}}
                  {{item.defence.base}}
                </div>
              </div>
              {{else if (eq item.defence.shieldposition "front")}}
              <div class="toprow">
                <div class="headinfo single" title="{{localize 'local.header.defences.title.mel'}}">
                  {{localize 'local.header.defences.mel'}}
                  {{item.defence.meleeDB}}
                </div>
                <div class="headinfo" title="{{localize 'local.header.shield.title'}}">
                  <select class="value select" name="system.defence.shieldposition">
                    {{#if (eq item.defence.meshield 0)}}
                    {{selectOptions ../config.selectOptions.withoutshield selected=item.defence.shieldposition valueAttr="value" labelAttr="label" localize=true}}
                    {{else}}
                    {{selectOptions ../config.selectOptions.withshield selected=item.defence.shieldposition valueAttr="value" labelAttr="label" localize=true}}
                    {{/if}}
                  </select>
                </div>
                <div class="headinfo single" title="{{localize 'local.header.defences.title.msl'}}">
                  {{localize 'local.header.defences.msl'}}
                  {{item.defence.missileDB}}
                </div>
              </div>
              <div class="midrow">
                <div class="headinfo single"></div>
                <div class="headinfo double item" data-item-id="{{item.defence.parry._id}}" title="{{localize 'local.header.defences.title.parry'}}">
                  {{localize 'local.header.defences.parry'}}
                  <input class="value iteminput" type="number" value="{{item.defence.parry.system.value}}" data-dtype="Number" data-name="system.attr" />
                </div>
                <div class="headinfo single" title="{{localize 'local.header.defences.title.at'}}">
                  {{localize 'local.header.defences.at'}}
                  {{item.defence.armourType}}
                </div>
              </div>
              <div class="bottomrow">
                <div class="headinfo single" title="{{localize 'local.header.defences.title.surprise'}}">
                  {{localize 'local.header.defences.surprise'}}
                  {{item.defence.surprise}}
                </div>
                <div class="headinfo single" title="{{localize 'local.header.defences.title.basedb'}}">
                  {{localize 'local.header.defences.basedb'}}
                  {{item.defence.base}}
                </div>
              </div>
              {{else}}
              <div class="toprow">
                <div class="headinfo single" title="{{localize 'local.header.defences.title.lhp'}}">
                  {{localize 'local.header.defences.lhp'}}
                  {{item.defence.lefthand}}
                </div>
                <div class="headinfo" title="{{localize 'local.header.shield.title'}}">
                  <select class="value select" name="system.defence.shieldposition">
                    {{#if (eq item.defence.meshield 0)}}
                    {{selectOptions ../config.selectOptions.withoutshield selected=item.defence.shieldposition valueAttr="value" labelAttr="label" localize=true}}
                    {{else}}
                    {{selectOptions ../config.selectOptions.withshield selected=item.defence.shieldposition valueAttr="value" labelAttr="label" localize=true}}
                    {{/if}}
                  </select>
                </div>
                <div class="headinfo single" title="{{localize 'local.header.defences.title.rhp'}}">
                  {{localize 'local.header.defences.rhp'}}
                  {{item.defence.righthand}}
                </div>
              </div>
              <div class="midrow">
                <div class="headinfo double" title="{{localize 'local.header.defences.title.split'}}">
                  {{localize 'local.header.defences.split'}}
                  <input class="value" type="number" name="system.defence.split" value="{{item.defence.split}}" data-dtype="Number" />
                </div>
                <div class="headinfo double item" data-item-id="{{item.defence.parry._id}}" title="{{localize 'local.header.defences.title.parry'}}">
                  {{localize 'local.header.defences.parry'}}
                  <input class="value iteminput" type="number" value="{{item.defence.parry.system.value}}" data-dtype="Number" data-name="system.attr" />
                </div>
                <div class="headinfo single" title="{{localize 'local.header.defences.title.at'}}">
                  {{localize 'local.header.defences.at'}}
                  {{item.defence.armourType}}
                </div>
              </div>
              <div class="bottomrow">
                <div class="headinfo single" title="{{localize 'local.header.defences.title.surprise'}}">
                  {{localize 'local.header.defences.surprise'}}
                  {{item.defence.surprise}}
                </div>
                <div class="headinfo single" title="{{localize 'local.header.defences.title.basedb'}}">
                  {{localize 'local.header.defences.basedb'}}
                  {{item.defence.base}}
                </div>
              </div>
              {{/if}}
            </div>
            {{/with}}
          </div>
        </div>
        <nav class="sheet-nav tabs" data-group="primary">
          <div class="buttons">
            <a class="tabtitle" data-tab="skills">
              {{localize 'local.tabs.skills'}}</a>
            <a class="tabtitle" data-tab="combat">
              {{localize 'local.tabs.combat'}}</a>
            <a class="tabtitle" data-tab="equipment">
              {{localize 'local.tabs.equipment'}}</a>
            {{#if system.adminMode}}
            <a class="tabtitle" data-tab="advancement">
              {{localize 'local.tabs.advancement'}}</a>
            <a class="tabtitle" data-tab="items">
              {{localize 'local.tabs.items'}}</a>
            <a class="tabtitle" data-tab="scripts">
              {{localize 'local.tabs.scripts.title'}}</a>
            {{else}}
            <div></div>
            <div></div>
            <div></div>
            {{/if}}
          </div>
          <div class="headinfo" title="Admin Mode">
            <input class="valuefull" type="checkbox" name="system.adminMode" {{checked system.adminMode}} data-dtype="Boolean" />
          </div>
        </nav>
      </header>
    </div>
    <section id="tabs" class="sheet-body">
      {{!-- Personal Tab --}}
      <div class="tab sheet-personal" data-tab="skills" data-group="primary">
        <div class="passions-block">
          <h3 class="collapsible {{#if (eq system.sections.disadvantages 'none')}}collapsed {{/if}}" data-section="disadvantages">
            {{localize 'local.actor.blocks.passions'}}
          </h3>
          <div class="content" style="display: {{system.sections.disadvantages}}">
            {{#each system.sheetData.disadvantages as |item|}}
            <div class="item passions-grid-section" data-item-id="{{item._id}}">
              <input class="iteminput" type="checkbox" data-name="system.applied" {{checked item.system.applied}} data-dtype="Boolean" />
              <label class="field-label header-field-label item-edit draggable" data-item-id="{{item._id}}">
                {{item.name}}</label>
              <div class="field-input" data-item-id="{{item._id}}">
                <input class="passions-text-field iteminput" type="text" value="{{item.system.notes}}" data-dtype="String" data-name="system.notes" />
              </div>
              <a class="rollable" data-name="{{item.name}}" data-roll="{{item.system.notes}}" data-type="tochat">
                <i class="fas fa-comment"></i>
              </a>
            </div>
            {{/each}}
            <h3>
              {{localize 'local.actor.blocks.revelations'}}
            </h3>
            {{#each system.sheetData.advantages as |item|}}
            <div class="item passions-grid-section" data-item-id="{{item._id}}">
              <input class="iteminput" type="checkbox" data-name="system.applied" {{checked item.system.applied}} data-dtype="Boolean" />
              <label class="field-label header-field-label item-edit draggable" data-item-id="{{item._id}}">
                {{item.name}}</label>
              <div class="field-input" data-item-id="{{item._id}}">
                <input class="passions-text-field iteminput" type="text" value="{{item.system.notes}}" data-dtype="String" data-name="system.notes" />
              </div>
              <a class="rollable" data-name="{{item.name}}" data-roll="{{item.system.notes}}" data-type="tochat">
                <i class="fas fa-comment"></i>
              </a>
            </div>
            {{/each}}
          </div>
        </div>
        <div class="main-grid-section">
          <div class="block-section leftside">
            <div class="drive-points">
              <h3 class="item" data-item-id="{{system.dynamic.drive._id}}">{{localize "local.actor.blocks.drive"}}</h3>
              <div class="drive-point-markers" data-item-id="{{system.dynamic.drive._id}}" data-name="system.attr">
                {{#times 5}}
                <div class="drive-point click-value" data-value="{{@index}}">
                  <i class="{{#if (lt ../system.dynamic.drive.system.value @index)}}far{{else}}fas{{/if}} fa-square"></i>
                </div>
                {{/times}}
              </div>
            </div>

            <div class="heroic-path-points">
              <h3 class="item" data-item-id="{{system.dynamic.hero._id}}">{{localize "local.actor.blocks.hero"}}</h3>
              <div class="heroic-path-markers" data-item-id="{{system.dynamic.hero._id}}" data-name="system.attr">
                {{#times 100}}
                {{#if (isModulus @index 20 10)}}
                {{! add a space }}
                <div class="heroic-path-point click-value" data-value="{{@index}}">
                  {{! a diamond }}
                  <i class="{{#if (lt ../system.dynamic.hero.system.value @index)}}far{{else}}fas{{/if}} fa-circle"></i>
                </div>
                <div class="heroic-path-gap"></div>
                {{else}}
                <div class="heroic-path-point click-value" data-value="{{@index}}">
                  {{#if (isModulus @index 10 0)}}
                  {{! a diamond }}
                  <i class="{{#if (lt ../system.dynamic.hero.system.value @index)}}far{{else}}fas{{/if}} fa-circle"></i>
                  {{else}}
                  {{! a square }}
                  <i class="{{#if (lt ../system.dynamic.hero.system.value @index)}}far{{else}}fas{{/if}} fa-square"></i>
                  {{/if}}
                </div>
                {{/if}}
                {{/times}}
              </div>
            </div>
            <div class="block-section">
              <h3 title="The measures of one's intrinsic capabilities and basic strengths or flaws.">
                {{localize 'local.actor.blocks.stats'}}
              </h3>
              <div class="like-table">
                <div class="like-row stats table-header">
                  <div class="like-cell">
                    {{localize 'local.actor.stats.name'}}
                  </div>
                  <div class="like-cell">
                    {{localize 'local.actor.stats.abbr'}}
                  </div>
                  <div class="like-cell">
                    {{localize 'local.actor.stats.base'}}
                  </div>
                  {{! use this to open the character creation modifiers}}
                  <div class="like-cell">
                    {{localize 'local.actor.stats.kin'}}
                  </div>
                  {{! use this to open the kin modifiers}}
                  <div class="like-cell">
                    {{localize 'local.actor.stats.spec'}}
                  </div>
                  <div class="like-cell">
                    {{localize 'local.actor.stats.total'}}
                  </div>
                  <div></div>
                </div>
                {{#each system.sheetData.statinfo as |item|}}
                <div class="like-row stats item" data-item-id="{{item._id}}" title="{{item.title}}">
                  <div class="like-cell left item-edit">
                    {{localize (concat 'local.system.stats.' item.name)}}
                  </div>
                  <div class="like-cell">
                    {{localize (concat 'local.system.stats.' item.abbr)}}
                  </div>
                  <div class="like-cell">
                    {{item.base}}
                  </div>
                  <div class="like-cell">
                    {{item.kin}}
                  </div>
                  <div class="like-cell">
                    {{item.spec}}
                  </div>
                  <div class="like-cell">
                    {{item.total}}
                  </div>
                  <a class="rollmacro" data-type="Primary" data-target="{{item.name}}">
                    <i class="fas fa-scroll"></i></a>
                </div>
                {{/each}}
              </div>
            </div>
            <div class="block-section">
              <h3>
                {{localize 'local.actor.blocks.saves'}}
              </h3>
              <div class="like-table">
                <div class="like-row saves table-header">
                  <div class="like-cell">
                    {{localize 'local.actor.saves.name'}}
                  </div>
                  <div class="like-cell">
                    {{localize 'local.actor.saves.stat'}}
                  </div>
                  <div class="like-cell">
                    {{localize 'local.actor.saves.lvl'}}
                  </div>
                  <div class="like-cell">
                    {{localize 'local.actor.saves.kin'}}
                  </div>
                  <div class="like-cell">
                    {{localize 'local.actor.saves.spec'}}
                  </div>
                  <div class="like-cell">
                    {{localize 'local.actor.saves.total'}}
                  </div>
                  <div></div>
                </div>
                {{#each system.sheetData.saveinfo as |item|}}
                <div class="like-row saves item" data-item-id="{{item._id}}" title="{{item.title}}">
                  <div class="like-cell left item-edit">
                    {{localize (concat 'local.system.saves.' item.name)}}
                  </div>
                  <div class="like-cell">
                    {{item.stat}}
                  </div>
                  <div class="like-cell">
                    {{item.level}}
                  </div>
                  <div class="like-cell">
                    {{item.kin}}
                  </div>
                  <div class="like-cell">
                    {{item.spec}}
                  </div>
                  <div class="like-cell rollable" data-name="{{item.fullname}}" data-roll="0" data-modtype="defence" data-type="modlist">
                    {{item.total}}
                  </div>
                  <a class="rollmacro" data-category="block" data-target="{{item.name}}">
                    <i class="fas fa-scroll"></i></a>
                </div>
                {{/each}}
              </div>
            </div>
            <div class="block-section">
              <h3>
                {{localize 'local.actor.blocks.spec'}}
              </h3>
              {{#each system.sheetData.perks as |item|}}
              <div class="item chatsender" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="item-edit draggable" data-item-id="{{item._id}}">
                  {{item.name}}</label>
                <a class="rollable" data-name="{{item.name}}" data-roll="{{item.system.notes}}" data-type="tochat">
                  <i class="fas fa-comment"></i>
                </a>
              </div>
              {{/each}}
            </div>
            <div class="block-section">
              <h3>
                {{localize 'local.actor.blocks.back'}}
              </h3>
              {{#each system.sheetData.quirks as |item|}}
              <div class="item chatsender" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="item-edit draggable" data-item-id="{{item._id}}">
                  {{item.name}}</label>
                <a class="rollable" data-name="{{item.name}}" data-roll="{{item.system.notes}}" data-type="tochat">
                  <i class="fas fa-comment"></i>
                </a>
              </div>
              {{/each}}
            </div>
            <div class="block-section">
              <h3>
                {{localize 'local.actor.blocks.lang'}}
              </h3>
              <input type="text" name="system.languages" value="{{system.languages}}" data-dtype="String" />
              {{#each system.sheetData.languageitems as |item|}}
              <div class="item chatsender" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="item-edit draggable" data-item-id="{{item._id}}">
                  {{item.name}}</label>
                <a class="rollable" data-name="{{item.name}}" data-roll="{{item.system.notes}}" data-type="tochat">
                  <i class="fas fa-comment"></i>
                </a>
              </div>
              {{/each}}
            </div>
            <div class="block-section">
              <h3>
                {{localize 'local.actor.blocks.char'}}
              </h3>
              {{#each system.sheetData.charactertraits as |item|}}
              <div class="item chatsender" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="item-edit draggable" data-item-id="{{item._id}}">
                  {{item.name}}</label>
                <a class="rollable" data-name="{{item.name}}" data-roll="{{item.system.notes}}" data-type="tochat">
                  <i class="fas fa-comment"></i>
                </a>
              </div>
              {{/each}}
            </div>
          </div>
          <div class="block-section rightside">
            <h3>
              {{localize 'local.actor.skills.title'}}
            </h3>
            <div class="like-table item-list">
              {{#each system.sheetData.skillinfo as |category|}}
              <div class="like-row skills table-header">
                <div class="like-cell">
                  {{localize 'local.actor.skills.dp'}}:
                  {{category.devpts}}
                </div>
                <div class="like-cell left">
                  {{localize (concat 'local.system.skillcats.' category.name)}}
                </div>
                <div class="like-cell stats" title="{{localize 'local.actor.skills.statT'}}">
                  {{localize 'local.actor.skills.stat'}}
                </div>
                <div class="like-cell ranks" title="{{localize 'local.actor.skills.ranksT'}}">
                  {{localize 'local.actor.skills.ranks'}}
                </div>
