            </div>
            {{#each system.sheetData.equipment as |item|}}
            <div class="like-row equipment item {{item.system.group}} separator" data-item-id="{{item._id}}" title="{{item.system.description}}">
              <div class="like-cell left item-edit draggable" data-item-id="{{item._id}}">
                {{item.name}}
              </div>
              <div class="like-cell">
                {{item.system.quantity}}
              </div>
              <div class="like-cell">
                {{item.system.weight}} lbs
              </div>
              <div class="like-cell">
                {{item.system.cost}}
              </div>
              <div class="like-cell left">
                {{item.system.availability}}
              </div>
              <div class="like-cell left">
                {{{item.system.description}}}
              </div>
              <div class="like-cell left">
                {{item.system.notes}}
              </div>
            </div>
            {{/each}}
          </div>
        </div>
        <div class="passions-block">
          <h3>
            {{localize 'local.sections.experience'}}
          </h3>
          {{#each system.sheetData.experienceHooks as |item|}}
          <div class="item passions-grid-section" data-item-id="{{item._id}}">
            <input class="iteminput" type="checkbox" data-name="system.applied" {{checked item.system.applied}} data-dtype="Boolean" />
            <label class="field-label header-field-label item-edit draggable" data-item-id="{{item._id}}">
              {{item.name}}</label>
            <div class="field-input" data-item-id="{{item._id}}">
              <input class="passions-text-field iteminput" type="text" value="{{item.system.notes}}" data-dtype="String" data-name="system.notes" />
            </div>
          </div>
          {{/each}}
        </div>
        <div class="notes-section">
          <h3>
            {{localize 'local.sections.notes'}}
          </h3>
          <div class="biography">
            {{editor enrichment.system.biography target="system.biography" engine="prosemirror" button=true owner=owner editable=editable}}
          </div>
          <div class="notes">
            <textarea rows="18" name="system.notes">{{{system.notes}}}</textarea>
          </div>
        </div>
      </div>
      {{!-- Advancement Tab --}}
      <div class="tab sheet-advancement" data-tab="advancement" data-group="primary">
        <div class="block-section">
          <h3>
            {{localize 'local.actor.blocks.advances'}}
          </h3>
          <table class="advances-table">
            <tr class="advances-row header">
              {{#with system.sheetData.advancementGrid.vocation as |voc|}}
              <th class="advances-cell item" data-item-id="{{voc._id}}" title="{{voc.notes}}">
                <label class="draggable item-edit">
                  {{voc.name}}</label>
              </th>
              {{/with}}
              <th class="advances-cell left"></th>
              {{#each system.sheetData.advancementColumns as |column|}}
              <th class="advances-cell item" data-item-id="{{column._id}}" title="{{column.notes}}">
                <label class="draggable item-edit">
                  {{column.name}}</label>
              </th>
              {{/each}}
            </tr>
            <tr class="advances-row">
              <td class="advances-cell"></td>
              <td class="advances-cell left">
                {{localize 'local.actor.blocks.advanceslevel'}}
              </td>
              {{#with system.sheetData.advancementGrid.Level as |skill s|}}
              {{#each ../system.sheetData.advancementColumns as |column|}}
              {{#each skill as |col c|}}
              {{#if (eq c column.name)}}
              <td class="advances-cell">
                {{col}}
              </td>
              {{/if}}
              {{/each}}
              {{/each}}
              {{/with}}
            </tr>
            {{#each system.sheetData.skillinfo as |category|}}
            <tr class="advances-row category">
              <td class="advances-cell">
                {{localize 'local.actor.skills.dp'}}:
                {{category.devpts}}
              </td>
              <td class="advances-cell left categoryname">
                {{localize (concat 'local.system.skillcats.' category.name)}}
              </td>
              {{#each ../system.sheetData.advancementColumns as |column|}}
              <td class="advances-cell"></td>
              {{/each}}
            </tr>
            {{#each category.data as |item|}}
            <tr class="advances-row">
              <td class="advances-cell"></td>
              <td class="advances-cell left">
                {{#if (eq category.name "Spell Lores")}}
                {{item.name}}
                {{else if item.standard}}
                {{localize (concat 'local.system.skills.' item.name)}}
                {{else}}
                {{item.name}}
                {{/if}}
              </td>
              {{#each ../../system.sheetData.advancementGrid as |skill s|}}
              {{#if (eq s item.name)}}
              {{#each ../../../system.sheetData.advancementColumns as |column|}}
              {{#each skill as |col c|}}
              {{#if (eq c column.name)}}
              <td class="advances-cell">
                {{col}}
              </td>
              {{/if}}
              {{/each}}
              {{/each}}
              {{/if}}
              {{/each}}
            </tr>
            {{/each}}
            {{/each}}
          </table>
        </div>
      </div>
      {{!-- Owned Items Tab --}}
      <div class="tab sheet-items" data-tab="items" data-group="primary">
        {{!-- ITEM CREATION --}}
        <div class="section">
          <div class="content" style="display: block">
            <div class="threespan item-list">
              <div class="header">
                <label>{{localize "local.sections.itemcreation"}}</label>
              </div>
              {{#each system.sheetData.allitemstemp as |item|}}
              <div class="entry {{#if item.filtered}}inEffect{{/if}}">
                <label class="filter" data-type='{{item.name}}'>{{item.localname}}</label>
                <span></span>
                <a class="item-create" data-type='{{item.name}}'><i class="fas fa-plus"></i></a>
              </div>
              {{/each}}
            </div>
          </div>
        </div>
        <hr>
        <div class="section">
          <div class="sectionheader">
            <label>{{localize "local.sections.itemlist"}}</label>
          </div>
          <div class="content" style="display: block">
            <div class="nospan owneditems item-list">
              {{#each filtereditems as |item|}}

              {{#if (eq item.type "Primary-Attribute")}}
              <div class="item owneditem ability" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="name draggable item-edit">{{item.name}}</label>
                <label class="type">{{item.type}}</label>
                <input class="value iteminput" type="text" data-dtype="String" data-name="system.group" value="{{item.system.group}}" />
                <label class="value">{{item.system.attr}}</label>
              </div>
              {{else if (eq item.type "Modifier")}}
              <div class="item owneditem mod{{#if item.system.inEffect}} inEffect{{/if}}" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="name draggable item-edit">{{item.name}}</label>
                <label class="type item-toggle">{{item.type}}</label>
                <input class="value iteminput" type="text" data-dtype="String" data-name="system.group" value="{{item.system.group}}" />
                <div class="check" data-item-id="{{item._id}}">
                  <input class="value iteminput" type="checkbox" {{checked item.system.condition}} data-dtype="Boolean" data-name="system.condition" />
                  <span> Cond</span>
                </div>
                {{#unless (or item.system.once item.system.temporary)}}
                <div class="check" data-item-id="{{item._id}}">
                  <input class="value iteminput" type="checkbox" {{checked item.system.alwaysOn}} data-dtype="Boolean" data-name="system.alwaysOn" />
                  <span> Perm</span>
                </div>
                {{/unless}}
                {{#unless (or item.system.alwaysOn item.system.once)}}
                <div class="check" data-item-id="{{item._id}}">
                  <input class="value iteminput" type="checkbox" {{checked item.system.temporary}} data-dtype="Boolean" data-name="system.temporary" />
                  <span> Temp</span>
                </div>
                {{/unless}}
                {{#unless (or item.system.alwaysOn item.system.temporary)}}
                <div class="check" data-item-id="{{item._id}}">
                  <input class="value iteminput" type="checkbox" {{checked item.system.once}} data-dtype="Boolean" data-name="system.once" />
                  <span> Once</span>
                </div>
                {{/unless}}
              </div>
              {{else if (eq item.type "Variable")}}
              <div class="item owneditem var" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="name draggable item-edit">{{item.name}}</label>
                <label class="type">{{item.type}}</label>
                <input class="value iteminput" type="text" data-dtype="String" data-name="system.group" value="{{item.system.group}}" />
                <select class="value select iteminput" data-name="system.label">
                  {{selectOptions item.system.entries selected=item.system.label valueAttr="label" labelAttr="label"
                  localize=false}}
                </select>
                {{#unless item.system.once}}
                <div class="check" data-item-id="{{item._id}}">
                  <input class="value iteminput" type="checkbox" {{checked item.system.temporary}} data-dtype="Boolean" data-name="system.temporary" />
                  <span> Temp</span>
                </div>
                {{/unless}}
                {{#unless item.system.temporary}}
                <div class="check" data-item-id="{{item._id}}">
                  <input class="value iteminput" type="checkbox" {{checked item.system.once}} data-dtype="Boolean" data-name="system.once" />
                  <span> Once</span>
                </div>
                {{/unless}}
              </div>
              {{else if (eq item.type "Trait")}}
              <div class="item owneditem trait" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="name draggable item-edit">{{item.name}}</label>
                <label class="type">{{item.type}} ({{item.system.category}})</label>
                <input class="value iteminput" type="text" data-dtype="String" data-name="system.group" value="{{item.system.group}}" />
                <label class="snippet">{{item.system.notes}}</label>
              </div>
              {{else if (eq item.type "Pool")}}
              <div class="item owneditem pool" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="name draggable item-edit">{{item.name}}</label>
                <label class="type">{{item.type}}</label>
                <input class="value iteminput" type="text" data-dtype="String" data-name="system.group" value="{{item.system.group}}" />
                <input class="value iteminput" type="text" data-dtype="String" data-name="system.minForm" value="{{item.system.minForm}}" />
                <input class="value iteminput" type="number" data-dtype="Number" data-name="system.value" value="{{item.system.value}}" />
                <input class="value iteminput" type="text" data-dtype="String" data-name="system.maxForm" value="{{item.system.maxForm}}" />
              </div>
              {{else if (or (eq item.type "Melee-Attack")(eq item.type "Ranged-Attack"))}}
              <div class="item owneditem attack" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="name draggable item-edit">{{item.name}}</label>
                <label class="type">{{item.type}}</label>
                <input class="value iteminput" type="text" data-dtype="String" data-name="system.group" value="{{item.system.group}}" />
                <label class="value">{{item.system.formula}}</label>
              </div>
              {{else if (eq item.type "Rollable")}}
              <div class="item owneditem roll" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="name draggable item-edit">{{item.name}}</label>
                <label class="type">{{item.type}} ({{item.system.category}})</label>
                <input class="value iteminput" type="text" data-dtype="String" data-name="system.group" value="{{item.system.group}}" />
                <label class="value">{{item.system.formula}}</label>
              </div>
              {{else if item.system.formula}}
              <div class="item owneditem" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="name draggable item-edit">{{item.name}}</label>
                <label class="type">{{item.type}}</label>
                <input class="value iteminput" type="text" data-dtype="String" data-name="system.group" value="{{item.system.group}}" />
                <label class="value">{{item.system.formula}}</label>
              </div>
              {{else}} {{! Everything else }}
              <div class="item owneditem" data-item-id="{{item._id}}" title="{{item.system.notes}}">
                <label class="name draggable item-edit">{{item.name}}</label>
                <label class="type">{{item.type}}</label>
                <input class="value iteminput" type="text" data-dtype="String" data-name="system.group" value="{{item.system.group}}" />
                <label class="value">{{item.system.value}}</label>
              </div>
              {{/if}}
              {{/each}}
            </div>
          </div>
        </div>
      </div>
      {{!-- Script Engine Tab --}}
      <div class="tab sheet-scripts" data-tab="scripts" data-group="primary">
        {{!-- Script Pane --}}
        <div id="baseitems">
          <div class="item-controls">
            <div>
              <a class="item-control item-create" title="{{localize 'local.tabs.scripts.createT'}}">
                <i class="fas fa-plus"></i> {{localize "local.tabs.scripts.create"}}
              </a>
            </div>
            <div>
              <a class="item-control item-export" title="{{localize 'local.tabs.scripts.exportT'}}">
                <i class="fas fa-minus"></i> {{localize "local.tabs.scripts.export"}}
              </a>
            </div>
            <div>
              <a class="item-control importJSON" title="{{localize 'local.tabs.scripts.importjsonT'}}">
                <i class="fas fa-plus"></i> {{localize "local.tabs.scripts.importjson"}}
              </a>
            </div>
            <div>
              <a class="item-control importVsD" title="{{localize 'local.tabs.scripts.importvsdT'}}">
                <i class="fas fa-plus"></i> {{localize "local.tabs.scripts.importvsd"}}
              </a>
            </div>
            <div>
              <a class="item-control importERA" title="Import ERA XML">
                <i class="fas fa-plus"></i> Import ERA XML
              </a>
            </div>
          </div>
          <textarea rows="24" name="system.itemscript">{{{actor.system.itemscript}}}</textarea>
        </div>
      </div>
    </section>
  </div>
  <script> $("input").focusin(function () { $(this).select(); }); $("textarea").focusin(function () { $(this).select(); }); 
  </script>
</form>